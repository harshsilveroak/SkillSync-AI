# SkillSync AI Server Port
PORT=5000

# MongoDB Database Connection URI
MONGODB_URI=mongodb://localhost:27017/skillsync

# JWT Secret Key for Session Authentication Tokens
JWT_SECRET=skillsync_jwt_super_secret_key_2026

# Real Email SMTP Settings (Nodemailer Transporter)
# Configure with your SMTP provider (SendGrid, Mailgun, AWS SES, Gmail SMTP, Resend, etc.)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_smtp_username
EMAIL_PASSWORD=your_smtp_password
EMAIL_FROM="SkillSync AI" <no-reply@skillsync.ai>
